{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/woocommerce"
      }
    },
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/wedding/:domain",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|whatsapp|facebookexternalhit|Facebot|facebot|Twitterbot|twitterbot|Slackbot|slackbot|Discordbot|discordbot|LinkedInBot|linkedinbot|TelegramBot|telegrambot|SkypeUriPreview|skypeuripreview|Googlebot|googlebot|bingbot|Bingbot|DuckDuckBot|duckduckbot).*"
        }
      ],
      "destination": "/api/og/wedding/:domain"
    },
    {
      "source": "/wedding/:domain/checkin",
      "destination": "/index.html"
    },
    {
      "source": "/wedding/:domain",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
