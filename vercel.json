{
  "rewrites": [
    {
      "source": "/wedding/:domain",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|whatsapp|facebookexternalhit|Facebot|facebot|Twitterbot|twitterbot|TelegramBot|telegrambot|LinkedInBot|linkedinbot|Slackbot|slackbot|Discordbot|discordbot|Pinterest|pinterest).*"
        }
      ],
      "destination": "/api/og/wedding/:domain"
    },
    {
      "source": "/wedding/:domain/checkin",
      "destination": "/index.html"
    },
    {
      "source": "/wedding/:domain",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
